---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Journal — Cat Care & Breed Guides | JinLin Cattery" description="Guides and articles on British Shorthair and Maine Coon cats — breed information, care tips and advice for buying a kitten in the UAE.">
  <section class="section" style="padding-top:64px;">
    <div class="container">
      <div class="eyebrow" data-en="Journal" data-zh="博客">Journal</div>
      <h1 style="font-size:44px;margin-bottom:16px;" data-en="Guides, care & breed stories" data-zh="指南、照护与品种故事">Guides, care & breed stories</h1>
      <p class="section-sub" style="max-width:720px;" data-en="Practical guides and breed information to help you welcome and care for your new companion." data-zh="实用指南与品种知识，帮助您迎接并照顾好新伙伴。">Practical guides and breed information to help you welcome and care for your new companion.</p>

      <div class="kitten-grid">
        <a href="#" class="kitten-card">
          <div class="media"><img src="/images/british-shorthair.jpg" alt="British Shorthair breed guide" loading="lazy" width="1920" height="2560"></div>
          <div class="body">
            <div class="name" data-en="British Shorthair: temperament & care" data-zh="英短：性情与照护">British Shorthair: temperament & care</div>
            <div class="breed" data-en="Breed guide" data-zh="品种指南">Breed guide</div>
          </div>
        </a>
        <a href="#" class="kitten-card">
          <div class="media"><img src="/images/maine-coon.jpg" alt="Maine Coon breed guide" loading="lazy" width="1920" height="2560"></div>
          <div class="body">
            <div class="name" data-en="Maine Coon: the gentle giant" data-zh="缅因：温柔的巨人">Maine Coon: the gentle giant</div>
            <div class="breed" data-en="Breed guide" data-zh="品种指南">Breed guide</div>
          </div>
        </a>
        <a href="#" class="kitten-card">
          <div class="media"><img src="/images/hero-cat.jpg" alt="Bringing a kitten home guide" loading="lazy" width="1920" height="2560"></div>
          <div class="body">
            <div class="name" data-en="Bringing your kitten home" data-zh="迎接小猫回家">Bringing your kitten home</div>
            <div class="breed" data-en="Care guide" data-zh="照护指南">Care guide</div>
          </div>
        </a>
      </div>
    </div>
  </section>
</Layout>
