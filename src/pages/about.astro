---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us | JinLin Cattery — British Shorthair & Maine Coon UAE" description="Learn about JinLin Cattery — a responsible breeder of British Shorthair and Maine Coon cats, raising healthy, well-socialised kittens at home and delivering them to Dubai, Abu Dhabi and across the UAE.">
  <section class="section" style="padding-top:64px;">
    <div class="container">
      <div class="eyebrow" data-en="About us" data-zh="关于我们">About us</div>
      <h1 style="font-size:44px;margin-bottom:16px;" data-en="A cattery built on care, transparency and healthy kittens" data-zh="以用心、透明与健康猫咪为根基的猫舍">A cattery built on care, transparency and healthy kittens</h1>
      <p class="section-sub" style="max-width:720px;" data-en="JinLin is a responsible cattery specialising in British Shorthair and Maine Coon cats. We raise every kitten in our family home, never in cages, and deliver them door-to-door to families across the UAE." data-zh="JinLin 是一家专注英国短毛猫与缅因猫的负责任猫舍。每只猫咪都在家庭环境中养育、从不笼养，并门到门配送到阿联酋全境。">JinLin is a responsible cattery specialising in British Shorthair and Maine Coon cats. We raise every kitten in our family home, never in cages, and deliver them door-to-door to families across the UAE.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title" data-en="Our story" data-zh="我们的故事">Our story</h2>
      <p class="section-sub" data-en="What began as a deep love for cats grew into a commitment to raise healthy, well-tempered kittens with complete transparency." data-zh="源于对猫咪的热爱，逐渐成长为繁育健康、性情温顺、全程透明的猫咪的坚定承诺。">What began as a deep love for cats grew into a commitment to raise healthy, well-tempered kittens with complete transparency.</p>
      <div class="feature-grid">
        <div class="feature-card">
          <div class="icon">♡</div>
          <h3 data-en="Raised at home, never caged" data-zh="居家养育，从不笼养">Raised at home, never caged</h3>
          <p data-en="Our kittens grow up underfoot in a calm family home, handled daily and socialised from birth." data-zh="猫咪在宁静的家庭环境中成长，自幼每日亲密互动、充分社会化。">Our kittens grow up underfoot in a calm family home, handled daily and socialised from birth.</p>
        </div>
        <div class="feature-card">
          <div class="icon">§</div>
          <h3 data-en="Carefully selected" data-zh="精心筛选">Carefully selected</h3>
          <p data-en="We select our cats for type, coat quality and stable, affectionate temperament." data-zh="我们按品相、毛质与稳定温顺的性情精选猫咪。">We select our cats for type, coat quality and stable, affectionate temperament.</p>
        </div>
        <div class="feature-card">
          <div class="icon">✓</div>
          <h3 data-en="Health-first breeding" data-zh="健康优先的繁育">Health-first breeding</h3>
          <p data-en="Every kitten is vet-checked, vaccinated and microchipped before leaving, with full health records provided." data-zh="每只猫咪离舍前均经兽医检查、疫苗接种与芯片植入，并提供完整健康档案。">Every kitten is vet-checked, vaccinated and microchipped before leaving, with full health records provided.</p>
        </div>
        <div class="feature-card">
          <div class="icon">✈</div>
          <h3 data-en="International delivery, handled" data-zh="全程代办国际配送">International delivery, handled</h3>
          <p data-en="We manage veterinary certificates, import permits and customs clearance, delivering safely across the UAE." data-zh="我们代办兽医证书、进口许可与清关，安全配送到阿联酋全境。">We manage veterinary certificates, import permits and customs clearance, delivering safely across the UAE.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title" data-en="Our values" data-zh="我们的价值观">Our values</h2>
      <p class="section-sub" data-en="Three principles guide every kitten we place." data-zh="三个原则贯穿我们交付的每只猫咪。">Three principles guide every kitten we place.</p>
      <div class="steps">
        <div class="step">
          <div class="num">01</div>
          <h3 data-en="Transparency" data-zh="透明">Transparency</h3>
          <p data-en="Full documentation and honest communication at every stage." data-zh="每个环节都提供完整文件与诚实沟通。">Full documentation and honest communication at every stage.</p>
        </div>
        <div class="step">
          <div class="num">02</div>
          <h3 data-en="Responsibility" data-zh="责任">Responsibility</h3>
          <p data-en="We breed responsibly, in small numbers, and stand behind every kitten for life." data-zh="我们小规模、负责任地繁育，并对每只猫咪终身负责。">We breed responsibly, in small numbers, and stand behind every kitten for life.</p>
        </div>
        <div class="step">
          <div class="num">03</div>
          <h3 data-en="Care" data-zh="用心">Care</h3>
          <p data-en="Every kitten is family first — raised with love, patience and daily attention." data-zh="每只猫咪首先是家人——以爱、耐心与每日陪伴养育。">Every kitten is family first — raised with love, patience and daily attention.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="cta-band">
        <h2 data-en="Speak with us about our kittens" data-zh="与我们聊聊我们的猫咪">Speak with us about our kittens</h2>
        <p data-en="We'd love to tell you more about our breeding programme and upcoming litters." data-zh="我们很乐意为您详细介绍繁育计划与待产窝次。">We'd love to tell you more about our breeding programme and upcoming litters.</p>
        <a href="https://wa.me/971501234567?text=Hello%2C%20I%27d%20like%20to%20know%20more%20about%20your%20cattery" class="btn btn-wa" target="_blank" rel="noopener" data-en="Chat on WhatsApp" data-zh="WhatsApp 在线咨询">Chat on WhatsApp</a>
      </div>
    </div>
  </section>
</Layout>
